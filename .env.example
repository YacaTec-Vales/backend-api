# =========================================
# Vales YacaTec - Backend API
# =========================================
# Copia este archivo a `.env` y rellena los valores reales para tu entorno.
# `.env` está en `.gitignore` y nunca debe commitearse al repositorio.
#
#   cp .env.example .env
#
# Las variables se cargan vía `@nestjs/config` (ConfigModule global)
# y se leen con `configService.get<T>('VAR_NAME')`.

# === Runtime ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# === Database ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=change-me
DATABASE_NAME=misvales
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Database (read replica) ===
# Por defecto apunta al mismo servidor que DATABASE_*.
# Apuntar este bloque a un usuario de lectura separado cuando se
# disponibilice la replica.
DATABASE_READ_HOST=localhost
DATABASE_READ_PORT=5432
DATABASE_READ_USER=app
DATABASE_READ_PASSWORD=change-me
DATABASE_READ_NAME=misvales
DATABASE_READ_SSL=false
DATABASE_READ_POOL_MIN=2
DATABASE_READ_POOL_MAX=10

# === JWT ===
# JWT_SECRET: minimo 32 bytes. Genera con: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ISSUER=vales-yacatec
JWT_AUDIENCE=vales-yacatec-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_REFRESH_REMEMBER_TTL=2592000

# === Argon2 (password hashing) ===
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# === Account lockout ===
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# === CORS / Cookies ===
# Lista separada por comas. Vacio = permite cualquier origen (dev only).
CORS_ORIGINS=https://tecu.yacatec.demo,https://calipx.yacatec.demo,https://poch.yacatec.demo
COOKIE_DOMAIN=.yacatec.demo
COOKIE_SECURE=true
APP_PUBLIC_URL=https://app.yacatec.demo

# === SMTP / Mail ===
# Si SMTP_HOST esta vacio, los envios de email se loguean y descartan.
# Para Mailtrap en desarrollo:
#   1. Crear cuenta en https://mailtrap.io (free, ~30 s).
#   2. Crear inbox "dev-yacatec".
#   3. Copiar credenciales SMTP del inbox en este archivo.
#   4. Mantener MAIL_DRIVER=smtp (default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mis Vales <no-reply@yacatec.demo>"
SMTP_SECURE=false
# MAIL_DRIVER: smtp (default) usa el transporte configurado arriba;
#   noop desactiva el envio (util para tests que no quieren mockear).
MAIL_DRIVER=smtp
# MAIL_FROM_NOTIFICATIONS: remitente para correos de la matriz de
#   notificaciones (vacio = usa SMTP_FROM).
MAIL_FROM_NOTIFICATIONS="Mis Vales Notificaciones <notificaciones@yacatec.demo>"
# MAIL_LOG_RETENTION_DAYS: retencion del futuro email_log (Phase F).
MAIL_LOG_RETENTION_DAYS=90

# === MFA ===
# MFA_SECRET_KEY: 32 bytes, AES-256-GCM. Genera con: openssl rand -base64 32
MFA_SECRET_KEY=replace-me-with-openssl-rand-base64-32
MFA_ISSUER=vales-yacatec
MFA_BACKUP_CODES_COUNT=10

# === Object storage (MinIO local o DigitalOcean Spaces en prod) ===
# Configurar con las credenciales del bucket propio.
# - MinIO local: https://host:port, force_path_style=true
# - DO Spaces: https://sfo3.digitaloceanspaces.com, force_path_style=false
STORAGE_ENDPOINT=https://your-bucket.example.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=misvales-storage
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=https://your-bucket.example.com/misvales-storage
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
