# =========================================
# Vales YacaTec - Backend API
# =========================================
# Copia este archivo a `.env` y rellena los valores reales para tu entorno.
# `.env` está en `.gitignore` y nunca debe commitearse al repositorio.
#
#   cp .env.example .env
#
# Las variables se cargan vía `@nestjs/config` (ConfigModule global)
# y se leen con `configService.get<T>('VAR_NAME')`.

# === Runtime ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# === Database ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=change-me
DATABASE_NAME=misvales
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === JWT ===
# JWT_SECRET: minimo 32 bytes. Genera con: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ISSUER=vales-yacatec
JWT_AUDIENCE=vales-yacatec-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_REFRESH_REMEMBER_TTL=2592000

# === Argon2 (password hashing) ===
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# === Account lockout ===
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# === CORS / Cookies ===
# Lista separada por comas. Vacio = permite cualquier origen (dev only).
CORS_ORIGINS=https://tecu.yacatec.demo,https://calipx.yacatec.demo,https://poch.yacatec.demo
COOKIE_DOMAIN=.yacatec.demo
COOKIE_SECURE=true
APP_PUBLIC_URL=https://app.yacatec.demo

# === SMTP ===
# Si SMTP_HOST esta vacio, los envios de email se loguean y descartan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mis Vales <no-reply@yacatec.demo>"
SMTP_SECURE=false

# === MFA ===
# MFA_SECRET_KEY: 32 bytes, AES-256-GCM. Genera con: openssl rand -base64 32
MFA_SECRET_KEY=replace-me-with-openssl-rand-base64-32
MFA_ISSUER=vales-yacatec
MFA_BACKUP_CODES_COUNT=10
