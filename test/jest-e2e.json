{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
  "moduleNameMapper": {
    "^@scalar/nestjs-api-reference$": "<rootDir>/test/mocks/scalar-api-reference.mock.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/setup/e2e.setup.ts"],
  "clearMocks": true,
  "restoreMocks": true,
  "maxWorkers": 1,
  "testTimeout": 30000
}
