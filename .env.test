NODE_ENV=test
PORT=3001
API_PREFIX=api/v1

# BD apuntando a la BD de test. Mientras no exista una BD
# dedicada, se usan las mismas variables que la BD de
# desarrollo. Renombrar host/name al migrar a una BD de
# pruebas dedicada (ver docu/backend/estilos/testing.md).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vales_yacatec_test
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

DATABASE_READ_HOST=127.0.0.1
DATABASE_READ_PORT=5432
DATABASE_READ_USER=postgres
DATABASE_READ_PASSWORD=postgres
DATABASE_READ_NAME=vales_yacatec_test
DATABASE_READ_SSL=false
DATABASE_READ_POOL_MIN=1
DATABASE_READ_POOL_MAX=5

# JWT y MFA con secretos de test (>=32 chars, NO usar en
# produccion).
JWT_SECRET=test-jwt-secret-32-chars-min-1234567890
JWT_ISSUER=vales-yacatec
JWT_AUDIENCE=vales-yacatec-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_REFRESH_REMEMBER_TTL=2592000

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_TEMP_PASSWORD_LENGTH=16

CORS_ORIGINS=
COOKIE_DOMAIN=
COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:3001

# SMTP vacio = modo degradado (no envia correos reales).
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test@yacatec.demo
SMTP_SECURE=false

MFA_SECRET_KEY=test-mfa-secret-32-chars-min-1234567890
MFA_ISSUER=vales-yacatec
MFA_BACKUP_CODES_COUNT=10
