{
  "name": "Mis Vales Yacatec — Backend API",
  "description": "API REST de Mis Vales Yacatec: autenticación (JWT + Argon2 + MFA TOTP), sesiones, recuperación de contraseña y módulos de negocio.",
  "language": "es-ES",
  "theme": "stripe",
  "outputStyle": "compressed",
  "serve": true,
  "port": 8080,
  "host": "localhost",
  "base": "/",
  "silent": false,
  "open": false,
  "liveReload": true,
  "exportFormat": "html",
  "output": "./docs",
  "tsconfig": "./tsconfig.json",
  "hideGenerator": true,
  "disableSourceCode": false,
  "disableGraph": false,
  "disableCoverage": false,
  "disableRoutesGraph": false,
  "toggleMenuItems": [
    "modules",
    "components",
    "controllers",
    "injectables",
    "guards",
    "interceptors",
    "filters",
    "classes",
    "interfaces",
    "miscellaneous"
  ],
  "coverage": {
    "files": [
      { "name": "auth", "include": "src/auth/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "sessions", "include": "src/sessions/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "mfa", "include": "src/mfa/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "password-reset", "include": "src/password-reset/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "mail", "include": "src/mail/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "shared", "include": "src/shared/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "health", "include": "src/health/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "database", "include": "src/database/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "config", "include": "src/config/**/*.ts", "exclude": "**/*.spec.ts" }
    ]
  }
}
