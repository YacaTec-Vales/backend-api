{
  "name": "Mis Vales Yacatec — Backend API",
  "description": "API REST de Mis Vales Yacatec: autenticación (JWT + Argon2 + MFA TOTP), sesiones, recuperación de contraseña y módulos de negocio.",
  "language": "es-MX",
  "theme": "stripe",
  "extTheme": "",
  "outputStyle": "compressed",
  "serve": true,
  "port": 8080,
  "host": "localhost",
  "base": "/",
  "silent": false,
  "open": false,
  "liveReload": true,
  "useVersion": false,
  "exportFormat": "html",
  "output": "./docs",
  "tsconfig": "./tsconfig.json",
  "includes": "./docs-src",
  "includesName": "Guías",
  "navTabConfig": [
    { "id": "info", "label": "Inicio" },
    { "id": "modules", "label": "Módulos" },
    { "id": "controllers", "label": "Endpoints" },
    { "id": "services", "label": "Servicios" },
    { "id": "guards", "label": "Guards" },
    { "id": "interceptors", "label": "Interceptors" },
    { "id": "filters", "label": "Filtros" },
    { "id": "decorators", "label": "Decoradores" },
    { "id": "classes", "label": "Clases" },
    { "id": "interfaces", "label:": "Interfaces" },
    { "id": "coverage", "label": "Cobertura" },
    { "id": "additional", "label": "Guías" }
  ],
  "hideGenerator": true,
  "disableSourceCode": false,
  "disableGraph": false,
  "disableCoverage": false,
  "disablePrivate": false,
  "disableProtected": false,
  "disableInternal": false,
  "disableRoutesGraph": false,
  "disableSearch": false,
  "disableDependencies": false,
  "disableProperties": false,
  "silent": false,
  "coverage": {
    "files": [
      { "name": "auth", "include": "src/auth/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "sessions", "include": "src/sessions/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "mfa", "include": "src/mfa/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "password-reset", "include": "src/password-reset/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "mail", "include": "src/mail/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "shared", "include": "src/shared/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "health", "include": "src/health/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "database", "include": "src/database/**/*.ts", "exclude": "**/*.spec.ts" },
      { "name": "config", "include": "src/config/**/*.ts", "exclude": "**/*.spec.ts" }
    ]
  },
  "filterTemplates": true,
  "readme": "README.md"
}
