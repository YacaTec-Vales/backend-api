<!--
  @fileoverview Plantilla HBS de recuperacion de contrasena (publica).
  @templateKey reset-password
  @category auth
  @vars
    - displayName: nombre del destinatario.
    - resetUrl: URL absoluta con el token de recuperacion.
    - expiresInMinutes: minutos hasta que caduque el token.
  Variante minimalista (sin la cabecera oscura) para que el
  correo sea claro y "link-centric": el usuario debe hacer clic
  en el boton. Conserva los partials `header` y `footer` para
  compartir la nota de "no responder".
-->
{{> header }}
<div class="body">
  <h2>Hola, {{displayName}}</h2>
  <p>Recibimos una solicitud para restablecer la contrasena de tu cuenta en Mis Vales.</p>
  <p>Para continuar, haz clic en el siguiente enlace. Expira en {{expiresInMinutes}} minutos.</p>
  <p>
    <a href="{{resetUrl}}" class="btn">Restablecer contrasena</a>
  </p>
  <p>Si no solicitaste este cambio, puedes ignorar este correo. Tu contrasena actual seguira siendo valida.</p>
</div>
{{> footer }}
