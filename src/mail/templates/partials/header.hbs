<!--
  @fileoverview Partial `header` reutilizado por todas las plantillas.
  @usedBy reset-password.hbs, session-revoked.hbs, user-welcome.hbs,
          user-password-reset-by-admin.hbs
  @vars - (ninguno)
  Abre el documento HTML, declara los estilos compartidos y la
  cabecera "Mis Vales". El titulo (h1) es fijo; los bloques
  coloreados de cada plantilla (alerts, credentials, reason) usan
  las clases CSS definidas aqui.
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Vales</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f5f5f5; margin: 0; padding: 24px; color: #1f2937; }
    .container { max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .header { background: #0f172a; color: #ffffff; padding: 24px; text-align: center; }
    .header.danger { background: #7c2d12; }
    .header h1 { margin: 0; font-size: 22px; font-weight: 600; }
    .body { padding: 32px 24px; }
    .body h2 { font-size: 18px; margin: 0 0 16px; color: #0f172a; }
    .body p { line-height: 1.5; margin: 0 0 12px; }
    .credentials { background: #f1f5f9; border-left: 4px solid #0f172a; padding: 16px; border-radius: 6px; margin: 16px 0; }
    .credentials.danger { border-left-color: #7c2d12; }
    .credentials .label { font-size: 12px; text-transform: uppercase; color: #475569; letter-spacing: 0.05em; }
    .credentials .value { font-size: 18px; font-weight: 600; color: #0f172a; font-family: "SF Mono", Menlo, monospace; margin-top: 4px; word-break: break-all; }
    .alert { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 6px; margin: 16px 0; }
    .alert p { margin: 0; color: #78350f; font-size: 14px; }
    .reason { background: #fef2f2; border-left: 4px solid #b91c1c; padding: 12px 16px; border-radius: 6px; margin: 16px 0; }
    .reason p { margin: 0; color: #7f1d1d; font-size: 14px; }
    .btn { display: inline-block; background: #0f172a; color: #ffffff !important; text-decoration: none; padding: 12px 24px; border-radius: 8px; margin: 16px 0; font-weight: 500; }
    .btn.danger { background: #7c2d12; }
    .muted { font-size: 14px; color: #64748b; }
    .footer { background: #f8fafc; padding: 16px 24px; text-align: center; font-size: 12px; color: #64748b; }
  </style>
</head>
<body>
  <div class="container">
